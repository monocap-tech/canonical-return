namespace N2
def L : ℤ := 
def U : ℤ := 
theorem lowerEq : L=CRALP.Log2Actual.L+(0:ℤ)*CRALP.Log2Actual.L := by decide
theorem upperEq : U=CRALP.Log2Actual.U+(0:ℤ)*CRALP.Log2Actual.U := by decide
theorem actual : Contains ((L:ℝ)/logScale) ((U:ℝ)/logScale) (Real.log 2) :=
  scaleTrace 2 2 0 CRALP.Log2Actual.L CRALP.Log2Actual.U
    CRALP.Log2Actual.L CRALP.Log2Actual.U L U (by norm_num) (by norm_num)
    CRALP.Log2Actual.actualLog2 CRALP.Log2Actual.actualLog2 lowerEq upperEq
end N2

