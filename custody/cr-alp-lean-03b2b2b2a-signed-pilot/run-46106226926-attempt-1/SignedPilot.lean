theorem tSize : ts.size = 401 := by decide
theorem mSize : ms.size = 400 := by decide
def t (i : ℕ) : Grid := if h : i < 401 then ts[i]'(by rw [tSize]; exact h) else ⟨1,0⟩
def mid (i : ℕ) : Grid := if h : i < 400 then ms[i]'(by rw [mSize]; exact h) else ⟨1,0⟩
def out : Grid := ⟨,⟩
theorem initial : t 0 = atanArg := by decide
theorem allSteps : ∀ i : Fin 400, logStep v t mid i := by decide
theorem lowerSum : out.lo=(∑ i ∈ range 400, (mid i).lo)-1 := by decide
theorem upperSum : out.hi=(∑ i ∈ range 400, (mid i).hi)+1 := by decide
theorem actualReduced : Encl out (Real.arctan ((85*(Real.pi/(11/5))/2)/(2049/4))) := by
  have hg := absSound atanArgSound (show absGuard atanArg 1 3 by decide)
  have hg' : |((85*(Real.pi/(11/5))/2)/(2049/4))| ≤ 1/3 := by simpa only [Int.cast_one,Int.cast_ofNat] using hg
  have hg'' : |((85*(Real.pi/(11/5))/2)/(2049/4))| ≤ 1/3 := by simpa using hg'
  exact CRALP.SignedGridSeries.atanTrace v t mid out hg'' (by rw [initial]; exact atanArgSound) vSound allSteps lowerSum upperSum
end Atan
