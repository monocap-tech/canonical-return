  have hg' : |(85*(Real.pi/(11/5))*Real.log 9-(42:ℤ)*(2*Real.pi))| ≤ 4/1 := by simpa only [Int.cast_one,Int.cast_ofNat] using hg
  have hg'' : |(85*(Real.pi/(11/5))*Real.log 9-(42:ℤ)*(2*Real.pi))| ≤ 4 := by simpa using hg'
  exact sinTrace q t mid out hg'' (by rw [initial]; exact reducedSound) qSound allSteps lowerSum upperSum
