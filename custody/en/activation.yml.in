name: T1D EN extended sixteen-column action and merged energy
on:
  push:
    branches: [research/cr-int-t1d-en-extended-corrector-action-active]
permissions:
  contents: write
jobs:
  optimize:
    runs-on: ubuntu-latest
    timeout-minutes: 300
    env:
      OPENBLAS_NUM_THREADS: "4"
      OMP_NUM_THREADS: "4"
      PYTHONUNBUFFERED: "1"
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
      - name: Static source preflight
        run: |
          for f in custody/en/*.sh; do bash -n "$f"; done
          python - <<'PY'
          import ast, pathlib, json
          for p in pathlib.Path('custody/en').glob('*.py'):
              ast.parse(p.read_text(), filename=str(p))
          a=json.loads(pathlib.Path('custody/ej/generated/audit.json').read_text())
          assert a['best_margin_audited'] and a['leading_minor_count']==248 and a['columns']==31
          from fractions import Fraction as F
          em=json.loads(pathlib.Path('custody/em/generated/receiver-audit.json').read_text())
          selection=json.loads(pathlib.Path('custody/em/generated/selection.json').read_text())
          assert em['columns']==16 and len(set(em['new_indices']))==16 and em['new_indices']==selection['selected']
          assert F(em['rho'])<F(1,100) and F(em['coefficient_error'])<F(1,10**30)
          assert selection['owners'].count(32)==12 and selection['owners'].count(31)==4
          ek=json.loads(pathlib.Path('custody/ek/generated/screen.json').read_text())
          assert ek['ideal']['proxy32']<0 and ek['best']['proxy32']<0
          ext=json.loads(pathlib.Path('custody/eg/generated/extension.json').read_text())
          assert ext['cutoff']==65536 and ext['head_half_target_met'] and ext['all_block_half_targets_met']
          r=json.loads(pathlib.Path('custody/dz/generated/result.json').read_text())
          assert r['dimension']==31 and r['physical_correctors']==352
          assert not r['best']['positive'] and r['best']['lower']=='-9/10000'
          assert r['proposal']['nominal_on_trial']>0
          print('EN SOURCE PREFLIGHT PASS')
          PY
      - name: Install numerical environment
        run: |
          mkdir -p custody/en/generated
          python -m pip install numpy==2.3.5 scipy==1.17.0
          (cd custody/en && python -c "import select, subprocess; from scipy.sparse.linalg import cg; assert callable(select.select) and callable(cg); print('EN IMPORT REGRESSION PASS', select.__file__)")
          python --version > custody/en/generated/python-version.txt
          python -m pip freeze > custody/en/generated/pip-freeze.txt
      - name: Verify committed CF files and reconstruct original source
        run: |
          (cd custody/cf/generated && sha256sum -c sha256.txt)
          (cd custody/cg/generated && sha256sum -c sha256.txt)
          (cd custody/ch/generated && sha256sum -c sha256.txt)
          (cd custody/cj/generated && sha256sum -c sha256.txt)
          (cd custody/ck/generated && sha256sum -c sha256.txt)
          (cd custody/cl/generated && sha256sum -c sha256.txt)
          (cd custody/cm/generated && sha256sum -c sha256.txt)
          (cd custody/cn/generated && sha256sum -c sha256.txt)
          (cd custody/co/generated && sha256sum -c sha256.txt)
          (cd custody/cp/generated && sha256sum -c sha256.txt)
          (cd custody/cq/generated && sha256sum -c sha256.txt)
          (cd custody/cr/generated && sha256sum -c sha256.txt)
          (cd custody/cs/generated && sha256sum -c sha256.txt)
          (cd custody/ct/generated && sha256sum -c sha256.txt)
          (cd custody/cu/generated && sha256sum -c sha256.txt)
          (cd custody/cv/generated && sha256sum -c sha256.txt)
          (cd custody/cw/generated && sha256sum -c sha256.txt)
          (cd custody/cx/generated && sha256sum -c sha256.txt)
          (cd custody/cy/generated && sha256sum -c sha256.txt)
          (cd custody/cz/generated && sha256sum -c sha256.txt)
          (cd custody/da/generated && sha256sum -c sha256.txt)
          (cd custody/db/generated && sha256sum -c sha256.txt)
          (cd custody/dc/generated && sha256sum -c sha256.txt)
          (cd custody/de/generated && sha256sum -c sha256.txt)
          (cd custody/dg/generated && sha256sum -c sha256.txt)
          (cd custody/di/generated && sha256sum -c sha256.txt)
          (cd custody/dk/generated && sha256sum -c sha256.txt)
          (cd custody/dm/generated && sha256sum -c sha256.txt)
          (cd custody/dn/generated && sha256sum -c sha256.txt)
          (cd custody/dq/generated && sha256sum -c sha256.txt)
          (cd custody/ds/generated && sha256sum -c sha256.txt)
          (cd custody/du/generated && sha256sum -c sha256.txt)
          (cd custody/dv/generated && sha256sum -c sha256.txt)
          (cd custody/dx/generated && sha256sum -c sha256.txt)
          (cd custody/dy/generated && sha256sum -c sha256.txt)
          (cd custody/dz/generated && sha256sum -c sha256.txt)
          (cd custody/eb/generated && sha256sum -c sha256.txt)
          (cd custody/ec/generated && sha256sum -c sha256.txt)
          (cd custody/ed/generated && sha256sum -c sha256.txt)
          (cd custody/ee/generated && sha256sum -c sha256.txt)
          (cd custody/ef/generated && sha256sum -c sha256.txt)
          (cd custody/eg/generated && sha256sum -c sha256.txt)
          for stage in eh ei ej ek em; do (cd custody/$stage/generated && sha256sum -c sha256.txt); done
          python custody/ce/reconstruct.py
          python - <<'PY'
          import csv
          def read(path):
              with open(path) as f: return {r.get('archive',r.get('name')):(int(r['bytes']),r['sha256']) for r in csv.DictReader(f,delimiter='\t')}
          assert read('custody/ce/evidence/archive-sha256.tsv')==read('ce-output/archive-verification.tsv')
          print('ALL 56 CE DIGESTS MATCH')
          PY
      - name: Verify recorded inherited paths
        run: python custody/recover_t1d_dependencies.py ce-output/archives ce-output/pristine --ledger custody/missing_inherited.tsv --report custody/en/generated/recovery.tsv
      - name: Extended new-block directed action and merged energy
        run: bash custody/en/run.sh
      - name: Manifest and permanent evidence
        if: always()
        run: |
          mkdir -p custody/en/generated
          (cd custody/en/generated && find . -type f ! -name sha256.txt -print0 | sort -z | xargs -0 -r sha256sum > sha256.txt && sha256sum -c sha256.txt)
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com
          branch="research/cr-int-t1d-en-evidence-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          git switch -c "$branch"
          git add -f custody/en/generated/
          if ! git diff --cached --quiet; then git commit -m "EN extended action evidence run ${GITHUB_RUN_ID}"; fi
          git push origin "HEAD:refs/heads/$branch"
      - name: Artifact fallback
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: t1d-en-evidence
          path: custody/en/generated/
          retention-days: 90
